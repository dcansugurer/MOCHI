params.max_cpus   = 20          // total cpu, change with --max_cpus if given by the user
params.max_memory = '40 GB'     // total memory, change with --max_memory if given by the user

process {
    executor = 'local'
    cpus   = 1
    memory = 2.GB

    withName: FASTQC           { cpus = 2;  memory = 4.GB  }
    withName: TRIMGALORE       { cpus = 4;  memory = 8.GB  }
    withName: STAR             { cpus = 5;  memory = 32.GB }
    withName: JFCOUNT          { cpus = 5;  memory = 6.GB  }   // jellyfish -t ${task.cpus}
    withName: JFDUMP           { cpus = 5;  memory = 12.GB }   // sort --parallel=${task.cpus}
    withName: JOINCOUNTS       { cpus = 1;  memory = 4.GB  }
    withName: KAMRATINDEX      { cpus = 1;  memory = 4.GB  }
    withName: KAMRATMASK       { cpus = 1;  memory = 4.GB  }
    withName: KAMRATMERGE      { cpus = 1;  memory = 4.GB  }
    withName: INTRONRETENTIONS { cpus = 8;  memory = 4.GB  }
    withName: EXONEXTENSIONS   { cpus = 8;  memory = 4.GB  }
    withName: COVEREDCANDIDATES{ cpus = 8;  memory = 4.GB  }
    withName: 'ANNOTCONTIGS.*' { cpus = 8;  memory = 16.GB }
}

executor {
    cpus   = params.max_cpus
    memory = params.max_memory
}
